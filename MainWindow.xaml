<?xml version="1.0" encoding="utf-8"?>  
<Window
    x:Class="PaperlessDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaperlessDesktop.ViewModels"
    xmlns:controls="using:PaperlessDesktop.Controls"
    Title="Paperless Desktop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Grid Grid.Row="0"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
              Padding="16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Paperless Desktop"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="LicenseStatusBlock"
                       Text="Loading..." HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="13"/>
            <Button Grid.Column="2" x:Name="ActivateBtn"
                    Content="Activate Pro" Click="ActivateBtn_Click"
                    Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}" Padding="8,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DOCUMENTS"
                           FontSize="10" FontWeight="Bold" Opacity="0.5" Margin="4,0,0,6"/>
                <ListView Grid.Row="1" x:Name="FileListView"
                          SelectionMode="Multiple"
                          AllowDrop="True"
                          DragOver="FileListView_DragOver"
                          Drop="FileListView_Drop"
                          SelectionChanged="FileListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{ThemeResource SystemAccentColor}"
                                        CornerRadius="3" Padding="4,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileType}" FontSize="9"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding PageCount}"
                                           FontSize="11" Opacity="0.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6">
                    <Button x:Name="MoveUpBtn"   Content="^" Width="40" Margin="0,0,4,0"
                            Click="MoveUpBtn_Click"/>
                    <Button x:Name="MoveDownBtn" Content="v" Width="40"
                            Click="MoveDownBtn_Click"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="AddBtn"    Content="+ Add"    Click="AddBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button x:Name="RemoveBtn" Content="- Remove" Click="RemoveBtn_Click"/>
                    <Button x:Name="ClearBtn"  Content="x"        Click="ClearBtn_Click"
                            ToolTipService.ToolTip="Clear all"/>
                </StackPanel>
            </Grid>

            <!-- PREVIEW -->
            <controls:PreviewPane Grid.Column="1" x:Name="Preview"/>

            <!-- ACTION PANEL -->
            <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                <Pivot x:Name="ActionPivot">

                    <PivotItem Header="PDF">
                        <ScrollViewer>
                            <StackPanel Padding="12,8" Spacing="4">
                                <TextBlock Text="MERGE AND PAGES" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,8,0,4"/>
                                <Button Content="Merge PDFs"       Click="MergePdfs_Click"      HorizontalAlignment="Stretch"/>
                                <Button Content="Remove Pages"     Click="RemovePages_Click"    HorizontalAlignment="Stretch"/>
                                <Button Content="Rotate Pages"     Click="RotatePages_Click"    HorizontalAlignment="Stretch"/>
                                <Button Content="Insert Pages [PRO]" Click="InsertPages_Click"  HorizontalAlignment="Stretch"/>
                                <TextBlock Text="SECURITY" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                                <Button Content="Password Protect [PRO]" Click="PasswordProtect_Click" HorizontalAlignment="Stretch"/>
                                <Button Content="Unlock PDF [PRO]"       Click="UnlockPdf_Click"       HorizontalAlignment="Stretch"/>
                                <TextBlock Text="METADATA" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                                <Button Content="Edit Metadata [PRO]" Click="EditMetadata_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="Pro">
                        <ScrollViewer>
                            <StackPanel Padding="12,8" Spacing="4">
                                <TextBlock Text="OCR AND CONVERT" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,8,0,4"/>
                                <Button Content="OCR PDF [PRO]"      Click="OcrPdf_Click"       HorizontalAlignment="Stretch"/>
                                <Button Content="PDF to DOCX [PRO]"  Click="PdfToDocx_Click"    HorizontalAlignment="Stretch"/>
                                <Button Content="PDF to Images [PRO]" Click="PdfToImages_Click" HorizontalAlignment="Stretch"/>
                                <Button Content="Images to PDF [PRO]" Click="ImagesToPdf_Click" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="OPTIMISE" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                                <Button Content="Compress PDF [PRO]" Click="CompressPdf_Click"  HorizontalAlignment="Stretch"/>
                                <Button Content="Split PDF [PRO]"    Click="SplitPdf_Click"     HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="Files">
                        <ScrollViewer>
                            <StackPanel Padding="12,8" Spacing="4">
                                <TextBlock Text="IMAGE EDITOR" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,8,0,4"/>
                                <Button Content="Open Image Editor"  Click="ImageEditor_Click"     HorizontalAlignment="Stretch"/>
                                <TextBlock Text="WORD DOCX" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                                <Button Content="Find and Replace"   Click="DocxFindReplace_Click" HorizontalAlignment="Stretch"/>
                                <Button Content="Merge DOCX"         Click="DocxMerge_Click"       HorizontalAlignment="Stretch"/>
                                <TextBlock Text="TABLES" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,12,0,4"/>
                                <Button Content="Open Table Editor"  Click="CsvViewer_Click"       HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                    <PivotItem Header="Batch">
                        <ScrollViewer>
                            <StackPanel Padding="12,8" Spacing="4">
                                <TextBlock Text="BATCH OPERATIONS" FontSize="10"
                                           FontWeight="Bold" Opacity="0.5" Margin="0,8,0,4"/>
                                <Button Content="Batch Compress [PRO]"     Click="BatchCompress_Click"   HorizontalAlignment="Stretch"/>
                                <Button Content="Batch OCR [PRO]"          Click="BatchOcr_Click"        HorizontalAlignment="Stretch"/>
                                <Button Content="Batch Remove Pages [PRO]" Click="BatchRemove_Click"     HorizontalAlignment="Stretch"/>
                                <Button Content="Batch Rotate [PRO]"       Click="BatchRotate_Click"     HorizontalAlignment="Stretch"/>
                                <Button Content="Batch PDF to Images [PRO]" Click="BatchPdfImages_Click" HorizontalAlignment="Stretch"/>
                                <Button Content="Export Report"            Click="ExportReport_Click"    HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </ScrollViewer>
                    </PivotItem>

                </Pivot>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Grid Grid.Row="2"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
              Padding="12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusBlock"
                       Text="Ready."
                       VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
            <TextBlock Grid.Column="1" x:Name="FileCountBlock"
                       Text="0 files"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>





