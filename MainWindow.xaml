<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PaperlessDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaperlessDesktop.ViewModels"
    xmlns:controls="using:PaperlessDesktop.Controls"
    Title="Paperless Desktop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- TOP BAR / title bar -->
            <RowDefinition Height="*"/>    <!-- BODY -->
            <RowDefinition Height="28"/>   <!-- STATUS BAR -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             TOP BAR
        ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Background="{StaticResource TopBarBrush}"
              Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- App icon + name -->
                <ColumnDefinition Width="*"/>      <!-- spacer -->
                <ColumnDefinition Width="Auto"/>   <!-- dark mode toggle -->
                <ColumnDefinition Width="Auto"/>   <!-- license status -->
                <ColumnDefinition Width="Auto"/>   <!-- activate button -->
            </Grid.ColumnDefinitions>

            <!-- App logo + name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontSize="18"
                          Foreground="{StaticResource BrandBlueBrush}"/>
                <TextBlock Text="Paperless Desktop"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Dark mode toggle -->
            <Button Grid.Column="2"
                    x:Name="DarkModeBtn"
                    Click="DarkModeBtn_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="36"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Toggle dark mode">
                <FontIcon x:Name="DarkModeIcon" Glyph="&#xE708;" FontSize="15"/>
            </Button>

            <!-- License badge -->
            <Border Grid.Column="3"
                    x:Name="LicenseBadge"
                    CornerRadius="12"
                    Padding="10,4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="LicenseStatusBlock"
                           Text="Trial"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Activate Pro button -->
            <Button Grid.Column="4"
                    x:Name="ActivateBtn"
                    Content="Activate Pro"
                    Click="ActivateBtn_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="14,6"
                    CornerRadius="6"/>
        </Grid>

        <!-- Top bar bottom border -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{StaticResource SeparatorBrush}"/>

        <!-- ═══════════════════════════════════════════════════════
             BODY  (sidebar | preview | action panel)
        ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────────────────────────────────────────────
                 LEFT SIDEBAR — file list
            ─────────────────────────────────────────────────── -->
            <Grid Grid.Column="0"
                  Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- list -->
                    <RowDefinition Height="Auto"/>   <!-- reorder -->
                </Grid.RowDefinitions>

                <!-- Toolbar: Add / Remove / Clear -->
                <Grid Grid.Row="0" Padding="8,8,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="AddBtn"
                            Click="AddBtn_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="6"
                            Padding="12,7"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                            <TextBlock Text="Add Files" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            x:Name="RemoveBtn"
                            Click="RemoveBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Remove selected">
                        <FontIcon Glyph="&#xE738;" FontSize="14"/>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="ClearBtn"
                            Click="ClearBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Clear all files">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    </Button>
                </Grid>

                <!-- Section label -->
                <TextBlock Grid.Row="0"
                           Text="DOCUMENTS"
                           Style="{StaticResource LabelUppercaseStyle}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           Padding="0,0,0,4"
                           Visibility="Collapsed"/>

                <!-- File list -->
                <Grid Grid.Row="1">
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Opacity="0.4">
                        <FontIcon Glyph="&#xE8A5;"
                                  FontSize="40"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop files here"
                                   FontSize="13"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="or click Add Files"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <!-- List -->
                    <ListView x:Name="FileListView"
                              SelectionMode="Extended"
                              AllowDrop="True"
                              DragOver="FileListView_DragOver"
                              Drop="FileListView_Drop"
                              SelectionChanged="FileListView_SelectionChanged"
                              DoubleTapped="FileListView_DoubleTapped"
                              Padding="4,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File type badge -->
                                    <Border Grid.Column="0"
                                            Background="{StaticResource BrandBlueLightBrush}"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            MinWidth="34">
                                        <TextBlock Text="{Binding FileType}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrandBlueBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- File name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"/>

                                    <!-- Page count -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PageCount}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Reorder strip -->
                <Grid Grid.Row="2" Padding="8,4,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="MoveUpBtn"
                            Click="MoveUpBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Move up">
                        <FontIcon Glyph="&#xE74A;" FontSize="13"/>
                    </Button>

                    <Button Grid.Column="1"
                            x:Name="MoveDownBtn"
                            Click="MoveDownBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Move down">
                        <FontIcon Glyph="&#xE74B;" FontSize="13"/>
                    </Button>

                    <TextBlock Grid.Column="2"
                               x:Name="FileCountBlock"
                               Text="0 files"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,4,0"/>
                </Grid>
            </Grid>

            <!-- Left border -->
            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                    Background="{StaticResource SeparatorBrush}"/>

            <!-- ───────────────────────────────────────────────────
                 CENTER + RIGHT — Per-file-type views
            ─────────────────────────────────────────────────── -->
            <Grid Grid.Column="1" Grid.ColumnSpan="2">

                <!-- All 5 views stacked; only one is Visible at a time -->
                <controls:EmptyView x:Name="ViewEmpty"/>
                <controls:PdfView   x:Name="ViewPdf"   Visibility="Collapsed"/>
                <controls:DocxView  x:Name="ViewDocx"  Visibility="Collapsed"/>
                <controls:ImageView x:Name="ViewImage" Visibility="Collapsed"/>
                <controls:XlsxView  x:Name="ViewXlsx"  Visibility="Collapsed"/>

            </Grid>

        </Grid>

        
        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="StatusBlock"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionCountBlock"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar top border -->
        <Border Grid.Row="2" VerticalAlignment="Top" Height="1"
                Background="{StaticResource SeparatorBrush}"/>

    </Grid>
</Window>
