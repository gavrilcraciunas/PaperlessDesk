<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PaperlessDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaperlessDesktop.ViewModels"
    xmlns:controls="using:PaperlessDesktop.Controls"
    Title="Paperless Desktop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             TOP BAR
        ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              x:Name="AppTitleBar"
              Background="{StaticResource TopBarBrush}"
              Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App logo + name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Image Source="Assets/logo_64_nobg.png"
                       Width="32" Height="32"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Paperless Desktop"
                           FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Features menu -->
            <Button Grid.Column="1"
                    x:Name="FeaturesMenuBtn"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    Width="Auto" Padding="10,6"
                    ToolTipService.ToolTip="All features overview">
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutSubItem Text="PDF Tools">
                            <MenuFlyoutItem Text="Merge PDFs"          x:Name="FlyMergePdf"      Click="FlyMergePdf_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Split PDF"           x:Name="FlySplitPdf"      Click="FlySplitPdf_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Remove Pages"        x:Name="FlyRemovePages"   Click="FlyRemovePages_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rotate Pages"        x:Name="FlyRotatePages"   Click="FlyRotatePages_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Insert Pages"        x:Name="FlyInsertPages"   Click="FlyInsertPages_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Password Protect"    x:Name="FlyPassword"      Click="FlyPassword_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Unlock PDF"          x:Name="FlyUnlock"        Click="FlyUnlock_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE785;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Edit Metadata"       x:Name="FlyMetadata"      Click="FlyMetadata_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="OCR PDF"             x:Name="FlyOcr"           Click="FlyOcr_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="PDF to Word"         x:Name="FlyPdfToDocx"     Click="FlyPdfToDocx_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="PDF to Images"       x:Name="FlyPdfToImages"   Click="FlyPdfToImages_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Compress PDF"        x:Name="FlyCompress"      Click="FlyCompress_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE94D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Image Tools">
                            <MenuFlyoutItem Text="Resize Image"        x:Name="FlyResize"        Click="FlyResize_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B8;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Crop Image"          x:Name="FlyCrop"          Click="FlyCrop_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A8;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Rotate Image"        x:Name="FlyRotateImg"     Click="FlyRotateImg_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Grayscale"           x:Name="FlyGrayscale"     Click="FlyGrayscale_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Images to PDF"       x:Name="FlyImagesToPdf"   Click="FlyImagesToPdf_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSubItem Text="Batch Operations">
                            <MenuFlyoutItem Text="Batch Compress"      x:Name="FlyBatchCompress" Click="FlyBatchCompress_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE94D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Batch OCR"           x:Name="FlyBatchOcr"      Click="FlyBatchOcr_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Batch Remove Pages"  x:Name="FlyBatchRemove"   Click="FlyBatchRemove_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Batch Rotate"        x:Name="FlyBatchRotate"   Click="FlyBatchRotate_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AD;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Batch PDF to Images" x:Name="FlyBatchImages"   Click="FlyBatchImages_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Export Batch Report" x:Name="FlyExportReport"  Click="FlyExportReport_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9F9;"/></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xEA40;" FontSize="13"/>
                    <TextBlock Text="Features" FontSize="13"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Help menu -->
            <Button Grid.Column="2"
                    x:Name="HelpMenuBtn"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    Width="Auto" Padding="10,6"
                    Margin="2,0,0,0"
                    ToolTipService.ToolTip="Help">
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Quick Start Guide"       Click="HelpQuickStart_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE82D;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Keyboard Shortcuts"      Click="HelpShortcuts_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE92E;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="About Paperless Desktop" Click="HelpAbout_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Send Feedback"           Click="HelpFeedback_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED15;"/></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE897;" FontSize="13"/>
                    <TextBlock Text="Help" FontSize="13"/>
                    <FontIcon Glyph="&#xE70D;" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Settings -->
            <Button Grid.Column="4"
                    x:Name="SettingsBtn"
                    Click="SettingsBtn_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="36"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="15"/>
            </Button>

            <!-- License badge -->
            <Border Grid.Column="5"
                    x:Name="LicenseBadge"
                    CornerRadius="12"
                    Padding="10,4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
                <TextBlock x:Name="LicenseStatusBlock"
                           Text="Trial"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Activate Pro button -->
            <Button Grid.Column="6"
                    x:Name="ActivateBtn"
                    Content="Activate Pro"
                    Click="ActivateBtn_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="14,6"
                    CornerRadius="6"/>
        </Grid>

        <!-- Top bar bottom border -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                Background="{StaticResource SeparatorBrush}"/>

        <!-- ═══════════════════════════════════════════════════════
             BODY  (sidebar | preview | action panel)
        ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" MaxWidth="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ───────────────────────────────────────────────────
                 LEFT SIDEBAR — file list
            ─────────────────────────────────────────────────── -->
            <Grid Grid.Column="0"
                  Background="{StaticResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- toolbar -->
                    <RowDefinition Height="*"/>      <!-- list -->
                    <RowDefinition Height="Auto"/>   <!-- reorder -->
                </Grid.RowDefinitions>

                <!-- Toolbar: Add (split) / Remove / Clear -->
                <Grid Grid.Row="0" Padding="8,8,8,4" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Split Add button -->
                    <SplitButton Grid.Column="0"
                                 x:Name="AddBtn"
                                 Click="AddBtn_Click"
                                 Style="{StaticResource AccentSplitButtonStyle}"
                                 Padding="12,7"
                                 HorizontalAlignment="Stretch">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Add Files…"  Click="AddFilesMenu_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Add Folder…" Click="AddFolderBtn_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Name="RecentFilesMenu" Text="Recent Files" Click="RecentFiles_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;"/></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13"/>
                            <TextBlock Text="Add Files" FontSize="13"/>
                        </StackPanel>
                    </SplitButton>

                    <Button Grid.Column="1"
                            x:Name="RemoveBtn"
                            Click="RemoveBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Remove selected">
                        <FontIcon Glyph="&#xE738;" FontSize="14"/>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="ClearBtn"
                            Click="ClearBtn_Click"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="4,0,0,0"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Clear all files">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    </Button>

                    <!-- Filter box -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBox x:Name="FilterBox"
                                 PlaceholderText="Filter files…"
                                 TextChanged="FilterBox_TextChanged"
                                 CornerRadius="6"
                                 FontSize="12"
                                 Padding="32,5,8,5"/>
                        <FontIcon Glyph="&#xE71E;" FontSize="11"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  IsHitTestVisible="False"/>
                    </Grid>
                </Grid>

                <!-- Section label -->
                <TextBlock Grid.Row="0"
                           Text="DOCUMENTS"
                           Style="{StaticResource LabelUppercaseStyle}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Bottom"
                           Padding="0,0,0,4"
                           Visibility="Collapsed"/>

                <!-- File list -->
                <Grid Grid.Row="1">
                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyStatePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Margin="16">
                        <Border Background="{StaticResource BrandBlueLightBrush}"
                                CornerRadius="16"
                                Width="56" Height="56"
                                HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;"
                                      FontSize="26"
                                      Foreground="{StaticResource BrandBlueBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No files yet"
                                   FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Click Add Files or drag &amp; drop"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <!-- List -->
                    <ListView x:Name="FileListView"
                              SelectionMode="Extended"
                              AllowDrop="True"
                              CanReorderItems="True"
                              CanDragItems="True"
                              DragOver="FileListView_DragOver"
                              Drop="FileListView_Drop"
                              SelectionChanged="FileListView_SelectionChanged"
                              DoubleTapped="FileListView_DoubleTapped"
                              Padding="4,0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Margin" Value="0,1"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File type badge with icon -->
                                    <Border Grid.Column="0"
                                            Background="{Binding FileTypeBadgeBrush}"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            MinWidth="34">
                                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                            <FontIcon Glyph="{Binding FileTypeGlyph}"
                                                      FontSize="10"
                                                      Foreground="{Binding FileTypeIconBrush}"/>
                                            <TextBlock Text="{Binding FileType}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding FileTypeIconBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- File name -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="13"/>

                                    <!-- Page count -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding PageCount}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Bottom strip: file count + selection count -->
                <Grid Grid.Row="2" Padding="12,4,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="FileCountBlock"
                               Text="0 files"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="SelectionCountBlock"
                               Text=""
                               FontSize="11"
                               Foreground="{StaticResource BrandBlueBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Left border -->
            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                    Background="{StaticResource SeparatorBrush}"/>

            <!-- ───────────────────────────────────────────────────
                 CENTER + RIGHT — Per-file-type views
            ─────────────────────────────────────────────────── -->
            <Grid Grid.Column="1">

                <!-- All 5 views stacked; only one is Visible at a time -->
                <controls:EmptyView x:Name="ViewEmpty"/>
                <controls:PdfView   x:Name="ViewPdf"   Visibility="Collapsed"/>
                <controls:DocxView  x:Name="ViewDocx"  Visibility="Collapsed"/>
                <controls:ImageView x:Name="ViewImage" Visibility="Collapsed"/>
                <controls:XlsxView  x:Name="ViewXlsx"  Visibility="Collapsed"/>

            </Grid>

        </Grid>

        <!-- Status bar top border -->
        <Border Grid.Row="2" VerticalAlignment="Top" Height="1"
                Background="{StaticResource SeparatorBrush}"/>

        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBrush}">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="StatusBlock"
                           Text="Ready"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           x:Name="InlineStatusLabel"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Visibility="Collapsed"/>

                <ProgressBar Grid.Column="2"
                             x:Name="StatusProgress"
                             Width="160" Height="5"
                             Minimum="0" Maximum="100"
                             IsIndeterminate="False"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Visibility="Collapsed"/>

                <Button Grid.Column="3"
                        x:Name="InlineCancelBtn"
                        Click="StatusCancelBtn_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Width="22" Height="22"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="Cancel operation">
                    <FontIcon Glyph="&#xE711;" FontSize="9"/>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
