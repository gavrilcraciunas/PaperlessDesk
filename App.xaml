<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PaperlessDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════
                 COLOUR TOKENS
            ═══════════════════════════════════════════════════ -->

            <!-- Brand -->
            <Color x:Key="BrandBlue">#0078D4</Color>
            <Color x:Key="BrandBlueDark">#005A9E</Color>
            <Color x:Key="BrandBlueLight">#EBF3FB</Color>

            <!-- Pro badge gold -->
            <Color x:Key="ProGold">#C8922A</Color>
            <Color x:Key="ProGoldLight">#FFF4CE</Color>

            <!-- Surfaces -->
            <Color x:Key="SidebarColor">#F5F5F5</Color>
            <Color x:Key="PanelColor">#FAFAFA</Color>
            <Color x:Key="TopBarColor">#FFFFFF</Color>
            <Color x:Key="StatusBarColor">#F0F0F0</Color>
            <Color x:Key="SeparatorColor">#E0E0E0</Color>

            <!-- Text -->
            <Color x:Key="TextPrimary">#1A1A1A</Color>
            <Color x:Key="TextSecondary">#666666</Color>
            <Color x:Key="TextDisabled">#AAAAAA</Color>

            <!-- Semantic -->
            <Color x:Key="SuccessColor">#107C10</Color>
            <Color x:Key="WarningColor">#CA5010</Color>
            <Color x:Key="ErrorColor">#C42B1C</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BrandBlueBrush"      Color="{StaticResource BrandBlue}"/>
            <SolidColorBrush x:Key="BrandBlueDarkBrush"  Color="{StaticResource BrandBlueDark}"/>
            <SolidColorBrush x:Key="BrandBlueLightBrush" Color="{StaticResource BrandBlueLight}"/>
            <SolidColorBrush x:Key="ProGoldBrush"        Color="{StaticResource ProGold}"/>
            <SolidColorBrush x:Key="ProGoldLightBrush"   Color="{StaticResource ProGoldLight}"/>
            <SolidColorBrush x:Key="SidebarBrush"        Color="{StaticResource SidebarColor}"/>
            <SolidColorBrush x:Key="PanelBrush"          Color="{StaticResource PanelColor}"/>
            <SolidColorBrush x:Key="TopBarBrush"         Color="{StaticResource TopBarColor}"/>
            <SolidColorBrush x:Key="StatusBarBrush"      Color="{StaticResource StatusBarColor}"/>
            <SolidColorBrush x:Key="SeparatorBrush"      Color="{StaticResource SeparatorColor}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"    Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"  Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextDisabledBrush"   Color="{StaticResource TextDisabled}"/>
            <SolidColorBrush x:Key="SuccessBrush"        Color="{StaticResource SuccessColor}"/>
            <SolidColorBrush x:Key="WarningBrush"        Color="{StaticResource WarningColor}"/>
            <SolidColorBrush x:Key="ErrorBrush"          Color="{StaticResource ErrorColor}"/>

            <!-- ═══════════════════════════════════════════════════
                 TYPOGRAPHY
            ═══════════════════════════════════════════════════ -->

            <Style x:Key="LabelUppercaseStyle" TargetType="TextBlock">
                <Setter Property="FontSize"       Value="10"/>
                <Setter Property="FontWeight"     Value="SemiBold"/>
                <Setter Property="Foreground"     Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="CharacterSpacing" Value="50"/>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="Margin"     Value="0,16,0,6"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════
                 PANEL TAB BUTTON  — compact top-tab strip
            ═══════════════════════════════════════════════════ -->
            <Style x:Key="PanelTabButtonStyle" TargetType="Button">
                <Setter Property="Padding"         Value="10,8"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="CornerRadius"    Value="0"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════
                 ACCENT SPLIT BUTTON
            ═══════════════════════════════════════════════════ -->
            <Style x:Key="AccentSplitButtonStyle" TargetType="SplitButton">
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding"                    Value="12,7"/>
                <Setter Property="CornerRadius"               Value="6"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="Background"                 Value="{StaticResource BrandBlueBrush}"/>
                <Setter Property="Foreground"                 Value="White"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════
                 ACTION BUTTON  — full-width, left-aligned icon+text
            ═══════════════════════════════════════════════════ -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding"                    Value="12,10"/>
                <Setter Property="CornerRadius"               Value="6"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="BorderBrush"                Value="Transparent"/>
                <Setter Property="Foreground"                 Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Margin"                     Value="0,1"/>
            </Style>

            <!-- PRO action button — gold left border accent -->
            <Style x:Key="ProActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="BorderBrush"      Value="{StaticResource ProGoldBrush}"/>
                <Setter Property="BorderThickness"  Value="0,0,0,0"/>
            </Style>

            <!-- ═══════════════════════════════════════════════════
                 ICON BUTTON  — square, no border
            ═══════════════════════════════════════════════════ -->
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width"           Value="32"/>
                <Setter Property="Height"          Value="32"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="CornerRadius"    Value="6"/>
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderBrush"     Value="Transparent"/>
                <Setter Property="FontSize"        Value="14"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
