<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaperlessDesktop.Controls.PreviewPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource SystemControlBackgroundAltMediumBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="8,6"
              Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="FileNameBlock" Text="No file selected"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,12,0"/>
            <AutoSuggestBox Grid.Column="1" x:Name="SearchBox"
                            PlaceholderText="Search in PDF (Ctrl+F)..."
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            MaxWidth="300" HorizontalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button x:Name="PrevPageBtn" Content="&lt;" Width="32"
                        Click="PrevPageBtn_Click" IsEnabled="False"/>
                <TextBlock x:Name="PageLabel" Text="-- / --"
                           VerticalAlignment="Center" FontSize="12"/>
                <Button x:Name="NextPageBtn" Content=">" Width="32"
                        Click="NextPageBtn_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4.0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Image x:Name="PageImage" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16"/>
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" x:Name="TextPreviewScroll"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="11"
                       Padding="16" TextWrapping="NoWrap" IsTextSelectionEnabled="True"/>
        </ScrollViewer>
        <StackPanel x:Name="EmptyState" Grid.Row="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35">
            <FontIcon Glyph="&#xE8A5;" FontSize="64"/>
            <TextBlock Text="Select a PDF to preview" FontSize="16" Margin="0,12,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Drag and drop files onto the list" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
