<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaperlessDesktop.Controls.ImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: IMAGE PREVIEW ───────────────────────────────────────── -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preview toolbar -->
            <Grid Grid.Row="0" Padding="12,8" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameBlock"
                           Grid.Column="0"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="DimensionsBlock"
                           Grid.Column="1"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <!-- Image -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          ZoomMode="Enabled">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="16"/>
            </ScrollViewer>
        </Grid>

        <!-- Separator -->
        <Border Grid.Column="1" Background="{StaticResource SeparatorBrush}"/>

        <!-- ── RIGHT: IMAGE ACTIONS ───────────────────────────────────────── -->
        <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
            <ScrollViewer Padding="10,8,10,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">

                    <!-- EDIT -->
                    <TextBlock Text="EDIT" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnResize" Click="Resize_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE744;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Resize" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Change image dimensions" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCrop" Click="Crop_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE91B;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Crop" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Trim to region" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateCW" Click="RotateCW_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7AD;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Rotate 90° CW" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Clockwise rotation" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotate180" Click="Rotate180_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7AD;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Rotate 180°" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Flip upside down" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnRotateCCW" Click="RotateCCW_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7AD;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Rotate 90° CCW" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Counter-clockwise rotation" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnGrayscale" Click="Grayscale_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE790;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Grayscale" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Convert to black and white" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- CONVERT -->
                    <TextBlock Text="CONVERT" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnImagesToPdf" Click="ImagesToPdf_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8B9;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Images → PDF" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource ProGoldLightBrush}"
                                            CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource ProGoldBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Combine selected images into PDF" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
