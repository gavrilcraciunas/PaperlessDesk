<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaperlessDesktop.Controls.DocxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ColorSwatchItemStyle" TargetType="GridViewItem">
            <Setter Property="Width"  Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="2"/>
            <Setter Property="MinWidth"  Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Border x:Name="Root"
                                CornerRadius="3"
                                BorderThickness="1.5"
                                BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SystemAccentColor}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SystemAccentColorDark1}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: DOCUMENT EDITOR ─────────────────────────────────────── -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- File name bar -->
            <Grid Grid.Row="0" Padding="12,8" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileNameBlock"
                           Grid.Column="0"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Grid.Column="1" x:Name="SaveDocxBtn"
                        Content="Save" Click="SaveDocx_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="14,5" CornerRadius="5"
                        IsEnabled="False"/>
            </Grid>

            <!-- Formatting toolbar -->
            <Grid Grid.Row="1" Padding="8,6" Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                    <ComboBox x:Name="FontCombo" Width="130"
                              SelectionChanged="FontCombo_SelectionChanged"
                              PlaceholderText="Font">
                        <x:String>Arial</x:String>
                        <x:String>Calibri</x:String>
                        <x:String>Times New Roman</x:String>
                        <x:String>Courier New</x:String>
                        <x:String>Georgia</x:String>
                        <x:String>Verdana</x:String>
                    </ComboBox>
                    <ComboBox x:Name="FontSizeCombo" Width="68"
                              SelectionChanged="FontSizeCombo_SelectionChanged"
                              PlaceholderText="Size">
                        <x:String>8</x:String>
                        <x:String>9</x:String>
                        <x:String>10</x:String>
                        <x:String>11</x:String>
                        <x:String>12</x:String>
                        <x:String>14</x:String>
                        <x:String>16</x:String>
                        <x:String>18</x:String>
                        <x:String>20</x:String>
                        <x:String>24</x:String>
                        <x:String>28</x:String>
                        <x:String>36</x:String>
                    </ComboBox>
                    <AppBarSeparator/>
                    <ToggleButton x:Name="BoldBtn" Width="36" Height="36" Padding="0"
                                  Click="BoldBtn_Click" ToolTipService.ToolTip="Bold (Ctrl+B)">
                        <FontIcon Glyph="&#xE8DD;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ItalicBtn" Width="36" Height="36" Padding="0"
                                  Click="ItalicBtn_Click" ToolTipService.ToolTip="Italic (Ctrl+I)">
                        <FontIcon Glyph="&#xE8DB;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="UnderlineBtn" Width="36" Height="36" Padding="0"
                                  Click="UnderlineBtn_Click" ToolTipService.ToolTip="Underline (Ctrl+U)">
                        <FontIcon Glyph="&#xE8DC;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="StrikeBtn" Width="36" Height="36" Padding="0"
                                  Click="StrikeBtn_Click" ToolTipService.ToolTip="Strikethrough">
                        <FontIcon Glyph="&#xEDE0;" FontSize="15"/>
                    </ToggleButton>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0">
                    <AppBarSeparator/>
                    <ToggleButton x:Name="AlignLeftBtn" Width="36" Height="36" Padding="0"
                                  Click="AlignLeftBtn_Click" ToolTipService.ToolTip="Align Left">
                        <FontIcon Glyph="&#xE8E4;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AlignCenterBtn" Width="36" Height="36" Padding="0"
                                  Click="AlignCenterBtn_Click" ToolTipService.ToolTip="Center">
                        <FontIcon Glyph="&#xE8E3;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AlignRightBtn" Width="36" Height="36" Padding="0"
                                  Click="AlignRightBtn_Click" ToolTipService.ToolTip="Align Right">
                        <FontIcon Glyph="&#xE8E2;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AlignJustifyBtn" Width="36" Height="36" Padding="0"
                                  Click="AlignJustifyBtn_Click" ToolTipService.ToolTip="Justify">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15"/>
                    </ToggleButton>
                    <AppBarSeparator/>
                    <ToggleButton x:Name="BulletsBtn" Width="36" Height="36" Padding="0"
                                  Click="BulletsBtn_Click" ToolTipService.ToolTip="Bullet List">
                        <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="NumbersBtn" Width="36" Height="36" Padding="0"
                                  Click="NumbersBtn_Click" ToolTipService.ToolTip="Numbered List">
                        <FontIcon Glyph="&#xEA42;" FontSize="15"/>
                    </ToggleButton>
                    <AppBarSeparator/>
                    <Button x:Name="IndentBtn" Width="36" Height="36" Padding="0"
                            Click="IndentBtn_Click" ToolTipService.ToolTip="Increase Indent">
                        <FontIcon Glyph="&#xE8E6;" FontSize="15"/>
                    </Button>
                    <Button x:Name="OutdentBtn" Width="36" Height="36" Padding="0"
                            Click="OutdentBtn_Click" ToolTipService.ToolTip="Decrease Indent">
                        <FontIcon Glyph="&#xE8E7;" FontSize="15"/>
                    </Button>
                </StackPanel>

                <!-- Color group -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0">
                    <AppBarSeparator/>

                    <!-- Text color -->
                    <Button x:Name="TextColorBtn" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Text Color">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" x:Name="TextColorFlyout">
                                <StackPanel Spacing="4" Padding="4">
                                    <TextBlock Text="Text Color" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <GridView x:Name="TextColorGrid" SelectionMode="None"
                                              ItemClick="TextColorGrid_ItemClick"
                                              IsItemClickEnabled="True"
                                              ItemContainerStyle="{StaticResource ColorSwatchItemStyle}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="24" Height="24">
                            <FontIcon Glyph="&#xE790;" FontSize="14" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="TextColorSwatch" Height="3"
                                       VerticalAlignment="Bottom" Margin="2,0,2,1"
                                       Fill="#FF000000" RadiusX="1" RadiusY="1"/>
                        </Grid>
                    </Button>

                    <!-- Highlight color -->
                    <Button x:Name="HighlightColorBtn" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Highlight Color">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" x:Name="HighlightColorFlyout">
                                <StackPanel Spacing="4" Padding="4">
                                    <TextBlock Text="Highlight Color" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Button Content="No Highlight" Click="HighlightNone_Click"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                    <GridView x:Name="HighlightColorGrid" SelectionMode="None"
                                              ItemClick="HighlightColorGrid_ItemClick"
                                              IsItemClickEnabled="True"
                                              ItemContainerStyle="{StaticResource ColorSwatchItemStyle}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="24" Height="24">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="HighlightColorSwatch" Height="3"
                                       VerticalAlignment="Bottom" Margin="2,0,2,1"
                                       Fill="#FFFFFF00" RadiusX="1" RadiusY="1"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- High-fidelity editable document renderer -->
            <WebView2 Grid.Row="2" x:Name="DocWebView"/>

            <!-- Status bar -->
            <TextBlock Grid.Row="3" x:Name="StatusText"
                       FontSize="11" Opacity="0.6"
                       Padding="12,4"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Grid>

        <!-- Separator -->
        <Border Grid.Column="1" Background="{StaticResource SeparatorBrush}"/>

        <!-- ── RIGHT: DOCX ACTIONS ────────────────────────────────────────── -->
        <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
            <ScrollViewer Padding="10,8,10,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">

                    <!-- EDIT -->
                    <TextBlock Text="EDIT" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnSave" Click="SaveDocx_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Save Document" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Write changes back to file" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSaveAs" Click="SaveDocxAs_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE792;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Save As…" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Save to a new file" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- TOOLS -->
                    <TextBlock Text="TOOLS" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnFindReplace" Click="FindReplace_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE721;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Find and Replace" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource ProGoldLightBrush}"
                                            CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource ProGoldBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Search text in DOCX" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnMergeDocx" Click="MergeDocx_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Merge DOCX" FontSize="13" FontWeight="SemiBold"/>
                                    <Border Background="{StaticResource ProGoldLightBrush}"
                                            CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="PRO" FontSize="9" FontWeight="Bold"
                                                   Foreground="{StaticResource ProGoldBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Combine Word documents" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
