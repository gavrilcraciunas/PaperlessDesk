<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaperlessDesktop.Controls.EmptyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource PanelBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="16" Opacity="0.45" MaxWidth="300">
            <FontIcon Glyph="&#xEA90;" FontSize="64"
                      Foreground="{StaticResource BrandBlueBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="No file selected"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Add files using the sidebar and select one to see its preview and available actions."
                       FontSize="13"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>

</UserControl>
