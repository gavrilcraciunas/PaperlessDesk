<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PaperlessDesktop.Controls.XlsxView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="XlsxColorSwatchItemStyle" TargetType="GridViewItem">
            <Setter Property="Width"   Value="20"/>
            <Setter Property="Height"  Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="2"/>
            <Setter Property="MinWidth"  Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Border x:Name="Root" CornerRadius="3"
                                BorderThickness="1.5" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.BorderBrush" Value="{ThemeResource SystemAccentColor}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="280" MinWidth="240" MaxWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT: SPREADSHEET ─────────────────────────────────────────── -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- toolbar -->
                <RowDefinition Height="Auto"/>   <!-- formatting bar -->
                <RowDefinition Height="Auto"/>   <!-- formula bar -->
                <RowDefinition Height="*"/>      <!-- grid -->
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Padding="10,6,10,6"
                  Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FileNameBlock"
                           Grid.Column="0"
                           FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <ComboBox x:Name="SheetCombo"
                          Grid.Column="1"
                          Margin="10,0,0,0"
                          MinWidth="110"
                          VerticalAlignment="Center"
                          SelectionChanged="SheetCombo_SelectionChanged"/>

                <TextBlock x:Name="StatsBlock"
                           Grid.Column="2"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <ToggleButton x:Name="HeaderRowToggle"
                              Grid.Column="3"
                              Content="Header Row"
                              IsChecked="True"
                              Click="HeaderRowToggle_Click"
                              Margin="8,0,0,0"
                              Padding="10,4"
                              VerticalAlignment="Center"
                              ToolTipService.ToolTip="Treat first row as column headers"/>
            </Grid>

            <!-- Formatting toolbar -->
            <Grid Grid.Row="1" Padding="8,5"
                  Background="{StaticResource SidebarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Font / size -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                    <ComboBox x:Name="XlFontCombo" Width="120"
                              PlaceholderText="Font"
                              SelectionChanged="XlFontCombo_SelectionChanged">
                        <x:String>Arial</x:String>
                        <x:String>Calibri</x:String>
                        <x:String>Courier New</x:String>
                        <x:String>Georgia</x:String>
                        <x:String>Times New Roman</x:String>
                        <x:String>Verdana</x:String>
                    </ComboBox>
                    <ComboBox x:Name="XlFontSizeCombo" Width="64"
                              PlaceholderText="Size"
                              SelectionChanged="XlFontSizeCombo_SelectionChanged">
                        <x:String>8</x:String>
                        <x:String>9</x:String>
                        <x:String>10</x:String>
                        <x:String>11</x:String>
                        <x:String>12</x:String>
                        <x:String>14</x:String>
                        <x:String>16</x:String>
                        <x:String>18</x:String>
                        <x:String>20</x:String>
                        <x:String>24</x:String>
                        <x:String>28</x:String>
                        <x:String>36</x:String>
                    </ComboBox>
                    <AppBarSeparator/>
                    <ToggleButton x:Name="XlBoldBtn" Width="36" Height="36" Padding="0"
                                  Click="XlBoldBtn_Click" ToolTipService.ToolTip="Bold">
                        <FontIcon Glyph="&#xE8DD;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="XlItalicBtn" Width="36" Height="36" Padding="0"
                                  Click="XlItalicBtn_Click" ToolTipService.ToolTip="Italic">
                        <FontIcon Glyph="&#xE8DB;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="XlUnderlineBtn" Width="36" Height="36" Padding="0"
                                  Click="XlUnderlineBtn_Click" ToolTipService.ToolTip="Underline">
                        <FontIcon Glyph="&#xE8DC;" FontSize="15"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Alignment -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0">
                    <AppBarSeparator/>
                    <ToggleButton x:Name="XlAlignLeftBtn" Width="36" Height="36" Padding="0"
                                  Click="XlAlignLeftBtn_Click" ToolTipService.ToolTip="Align Left">
                        <FontIcon Glyph="&#xE8E4;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="XlAlignCenterBtn" Width="36" Height="36" Padding="0"
                                  Click="XlAlignCenterBtn_Click" ToolTipService.ToolTip="Center">
                        <FontIcon Glyph="&#xE8E3;" FontSize="15"/>
                    </ToggleButton>
                    <ToggleButton x:Name="XlAlignRightBtn" Width="36" Height="36" Padding="0"
                                  Click="XlAlignRightBtn_Click" ToolTipService.ToolTip="Align Right">
                        <FontIcon Glyph="&#xE8E2;" FontSize="15"/>
                    </ToggleButton>
                </StackPanel>

                <!-- Colors -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" Margin="6,0,0,0">
                    <AppBarSeparator/>

                    <!-- Text color -->
                    <Button x:Name="XlTextColorBtn" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Text Color">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" x:Name="XlTextColorFlyout">
                                <StackPanel Spacing="4" Padding="4">
                                    <TextBlock Text="Text Color" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <GridView x:Name="XlTextColorGrid" SelectionMode="None"
                                              ItemClick="XlTextColorGrid_ItemClick"
                                              IsItemClickEnabled="True"
                                              ItemContainerStyle="{StaticResource XlsxColorSwatchItemStyle}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="24" Height="24">
                            <FontIcon Glyph="&#xE790;" FontSize="14" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="XlTextColorSwatch" Height="3"
                                       VerticalAlignment="Bottom" Margin="2,0,2,1"
                                       Fill="#FF000000" RadiusX="1" RadiusY="1"/>
                        </Grid>
                    </Button>

                    <!-- Fill color -->
                    <Button x:Name="XlFillColorBtn" Width="36" Height="36" Padding="0"
                            ToolTipService.ToolTip="Fill Color">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" x:Name="XlFillColorFlyout">
                                <StackPanel Spacing="4" Padding="4">
                                    <TextBlock Text="Fill Color" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <Button Content="No Fill" Click="XlFillNone_Click"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                                    <GridView x:Name="XlFillColorGrid" SelectionMode="None"
                                              ItemClick="XlFillColorGrid_ItemClick"
                                              IsItemClickEnabled="True"
                                              ItemContainerStyle="{StaticResource XlsxColorSwatchItemStyle}">
                                        <GridView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapGrid MaximumRowsOrColumns="10" Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </GridView.ItemsPanel>
                                    </GridView>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Grid Width="24" Height="24">
                            <FontIcon Glyph="&#xE771;" FontSize="14" VerticalAlignment="Top" Margin="0,-2,0,0"/>
                            <Rectangle x:Name="XlFillColorSwatch" Height="3"
                                       VerticalAlignment="Bottom" Margin="2,0,2,1"
                                       Fill="Transparent" RadiusX="1" RadiusY="1"/>
                        </Grid>
                    </Button>

                    <AppBarSeparator/>
                    <!-- Clear formatting -->
                    <Button Width="36" Height="36" Padding="0"
                            Click="XlClearFormat_Click" ToolTipService.ToolTip="Clear Formatting">
                        <FontIcon Glyph="&#xE8BB;" FontSize="15"/>
                    </Button>

                    <AppBarSeparator/>
                    <!-- Freeze header row -->
                    <ToggleButton x:Name="XlFreezeBtn" Width="36" Height="36" Padding="0"
                                  Click="XlFreezeBtn_Click" ToolTipService.ToolTip="Freeze Header Row">
                        <FontIcon Glyph="&#xE72E;" FontSize="15"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- Formula bar -->
            <Grid Grid.Row="2"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{StaticResource SeparatorBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="CellRefBox"
                         Grid.Column="0"
                         IsReadOnly="True"
                         TextAlignment="Center"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Padding="4,3"
                         Text=""
                         PlaceholderText="—"/>

                <Border Grid.Column="1"
                        Background="{StaticResource SeparatorBrush}"/>

                <TextBlock Grid.Column="2"
                           Text="fx"
                           FontStyle="Italic"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="8,0,8,0"/>

                <TextBox x:Name="FormulaBar"
                         Grid.Column="3"
                         BorderThickness="0"
                         FontSize="13"
                         Padding="4,3"
                         KeyDown="FormulaBar_KeyDown"
                         PlaceholderText="Select a cell to view or edit its value"/>
            </Grid>

            <!-- Spreadsheet grid: corner | col headers | row nums | cells -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Corner -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="#EFEFEF"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,0,1,1"/>

                <!-- Column headers (horizontal scroll only, synced with DataScroll) -->
                <ScrollViewer x:Name="ColHeaderScroll"
                              Grid.Row="0" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False">
                    <Canvas x:Name="ColHeaderCanvas" Height="28"/>
                </ScrollViewer>

                <!-- Frozen header row (visible only when freeze is active) -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="#EFEFEF" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1"
                        x:Name="FrozenCorner" Visibility="Collapsed"/>
                <ScrollViewer x:Name="FrozenHeaderScroll"
                              Grid.Row="1" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsHitTestVisible="False"
                              Visibility="Collapsed">
                    <Canvas x:Name="FrozenHeaderCanvas" Height="26"/>
                </ScrollViewer>

                <!-- Row numbers (vertical scroll only, synced with DataScroll) -->
                <ScrollViewer x:Name="RowNumScroll"
                              Grid.Row="2" Grid.Column="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              IsHitTestVisible="False">
                    <Canvas x:Name="RowNumCanvas" Width="50"/>
                </ScrollViewer>

                <!-- Main data canvas -->
                <ScrollViewer x:Name="DataScroll"
                              Grid.Row="2" Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              ViewChanged="DataScroll_ViewChanged"
                              KeyDown="DataScroll_KeyDown">
                    <Canvas x:Name="CellCanvas"
                            DoubleTapped="CellCanvas_DoubleTapped"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Separator -->
        <Border Grid.Column="1" Background="{StaticResource SeparatorBrush}"/>

        <!-- ── RIGHT: SPREADSHEET ACTIONS ────────────────────────────────── -->
        <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
            <ScrollViewer Padding="10,8,10,12"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">

                    <!-- EDIT -->
                    <TextBlock Text="EDIT" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnAddRow" Click="AddRow_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Add Row" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Append an empty row" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteRow" Click="DeleteRow_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Delete Row" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Remove selected row" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnInsertRow" Click="InsertRow_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Insert Row Above" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Insert row before selection" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnInsertCol" Click="InsertCol_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE710;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Insert Column Before" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Insert column before selection" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteCol" Click="DeleteCol_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Delete Column" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Remove selected column" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSortAsc"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74B;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Sort A → Z" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Sort by selected column" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnSortDesc" Click="SortDesc_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74A;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Sort Z → A" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Sort by selected column" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnFindReplace" Click="FindReplace_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE721;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Find &amp; Replace" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Search and replace cell values" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- EXPORT -->
                    <TextBlock Text="EXPORT" Style="{StaticResource SectionHeaderStyle}"/>

                    <Button x:Name="BtnSave" Click="Save_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Save" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Overwrite original file" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExportCsv" Click="ExportCsv_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9F9;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Export as CSV" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Save as comma-separated file" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExportXlsx" Click="ExportXlsx_Click" IsEnabled="False"
                            Style="{StaticResource ActionButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE9D2;" FontSize="16" Width="20"/>
                            <StackPanel>
                                <TextBlock Text="Export as XLSX" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Save as Excel spreadsheet" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
