<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="PaperlessDesktop.Dialogs.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Settings" PrimaryButtonText="Save" CloseButtonText="Cancel" DefaultButton="Primary" MinWidth="460"><StackPanel Spacing="20" Padding="0,8,0,4"><StackPanel Spacing="6"><TextBlock Text="DEFAULT OUTPUT FOLDER" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OutputDirBox" Grid.Column="0" PlaceholderText="Same folder as source file" IsReadOnly="True"/><Button Grid.Column="1" x:Name="BrowseOutputBtn" Click="BrowseOutputBtn_Click" Content="Browse..." Padding="12,7"/></Grid><TextBlock Text="Leave blank to always save next to the source file." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><StackPanel Spacing="6"><TextBlock Text="DEFAULT COMPRESS QUALITY" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50"/><ComboBox x:Name="QualityCombo" HorizontalAlignment="Stretch"><ComboBoxItem Content="screen - smallest file" Tag="screen"/><ComboBoxItem Content="ebook - good balance (recommended)" Tag="ebook"/><ComboBoxItem Content="printer - high quality" Tag="printer"/><ComboBoxItem Content="prepress - maximum quality" Tag="prepress"/></ComboBox></StackPanel><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><StackPanel Spacing="6"><TextBlock Text="DEFAULT OCR LANGUAGE" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50"/><ComboBox x:Name="OcrLangCombo" HorizontalAlignment="Stretch"><ComboBoxItem Content="English" Tag="eng"/><ComboBoxItem Content="Romanian" Tag="ron"/><ComboBoxItem Content="Romanian + English" Tag="ron+eng"/><ComboBoxItem Content="German" Tag="deu"/><ComboBoxItem Content="French" Tag="fra"/><ComboBoxItem Content="Spanish" Tag="spa"/><ComboBoxItem Content="Italian" Tag="ita"/></ComboBox></StackPanel><Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/><StackPanel Spacing="6"><TextBlock Text="GENERAL" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="50"/><ToggleSwitch x:Name="ShowPageCountToggle" Header="Show page count in file list" OnContent="On" OffContent="Off"/></StackPanel></StackPanel></ContentDialog>