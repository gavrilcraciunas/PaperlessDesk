<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PaperlessDesktop.Dialogs.FindReplaceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Find &amp; Replace"
    PrimaryButtonText="Replace All"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="FindBox" Header="Find" PlaceholderText="Text to find"/>
        <TextBox x:Name="ReplaceBox" Header="Replace with" PlaceholderText="Replacement text"/>
        <ToggleSwitch x:Name="MatchCaseToggle" Header="Match case" IsOn="False"/>
    </StackPanel>
</ContentDialog>