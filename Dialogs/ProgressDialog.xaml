<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PaperlessDesktop.Dialogs.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Processing..."
    CloseButtonText="Cancel"
    DefaultButton="None">
    <StackPanel Spacing="12" MinWidth="360" Padding="0,8">
        <TextBlock x:Name="ProgressLabel" Text="Starting..." FontSize="13"/>
        <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="ProgressDetail" FontSize="11" Opacity="0.6"/>
    </StackPanel>
</ContentDialog>
