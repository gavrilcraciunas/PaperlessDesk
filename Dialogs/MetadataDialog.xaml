<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PaperlessDesktop.Dialogs.MetadataDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit PDF Metadata"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <StackPanel Spacing="10" MinWidth="360">
        <TextBox x:Name="TitleBox"    Header="Title"/>
        <TextBox x:Name="AuthorBox"   Header="Author"/>
        <TextBox x:Name="SubjectBox"  Header="Subject"/>
        <TextBox x:Name="KeywordsBox" Header="Keywords"
                 PlaceholderText="e.g. invoice, 2026, Q1"/>
    </StackPanel>
</ContentDialog>
