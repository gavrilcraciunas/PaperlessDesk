<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PaperlessDesktop.Dialogs.DocxEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Word Document Editor"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}">

    <Grid Width="1000" Height="700">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File name -->
        <TextBlock Grid.Row="0" x:Name="FileNameBlock" 
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- Formatting toolbar -->
        <Grid Grid.Row="1" Padding="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Text formatting -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <ComboBox x:Name="FontCombo" Width="140" SelectionChanged="FontCombo_SelectionChanged"
                          PlaceholderText="Font">
                    <x:String>Arial</x:String>
                    <x:String>Calibri</x:String>
                    <x:String>Times New Roman</x:String>
                    <x:String>Courier New</x:String>
                    <x:String>Georgia</x:String>
                    <x:String>Verdana</x:String>
                </ComboBox>
                <ComboBox x:Name="FontSizeCombo" Width="70" SelectionChanged="FontSizeCombo_SelectionChanged"
                          PlaceholderText="Size">
                    <x:String>8</x:String>
                    <x:String>9</x:String>
                    <x:String>10</x:String>
                    <x:String>11</x:String>
                    <x:String>12</x:String>
                    <x:String>14</x:String>
                    <x:String>16</x:String>
                    <x:String>18</x:String>
                    <x:String>20</x:String>
                    <x:String>24</x:String>
                    <x:String>28</x:String>
                    <x:String>36</x:String>
                </ComboBox>
                <AppBarSeparator/>
                <ToggleButton x:Name="BoldBtn" Width="36" Height="36" Click="BoldBtn_Click"
                              ToolTipService.ToolTip="Bold (Ctrl+B)">
                    <FontIcon Glyph="&#xE8DD;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicBtn" Width="36" Height="36" Click="ItalicBtn_Click"
                              ToolTipService.ToolTip="Italic (Ctrl+I)">
                    <FontIcon Glyph="&#xE8DB;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineBtn" Width="36" Height="36" Click="UnderlineBtn_Click"
                              ToolTipService.ToolTip="Underline (Ctrl+U)">
                    <FontIcon Glyph="&#xE8DC;" FontSize="16"/>
                </ToggleButton>
            </StackPanel>

            <!-- Paragraph formatting -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
                <AppBarSeparator/>
                <ToggleButton x:Name="AlignLeftBtn" Width="36" Height="36" Click="AlignLeftBtn_Click"
                              ToolTipService.ToolTip="Align Left">
                    <FontIcon Glyph="&#xE8E4;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="AlignCenterBtn" Width="36" Height="36" Click="AlignCenterBtn_Click"
                              ToolTipService.ToolTip="Center">
                    <FontIcon Glyph="&#xE8E3;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="AlignRightBtn" Width="36" Height="36" Click="AlignRightBtn_Click"
                              ToolTipService.ToolTip="Align Right">
                    <FontIcon Glyph="&#xE8E2;" FontSize="16"/>
                </ToggleButton>
                <ToggleButton x:Name="AlignJustifyBtn" Width="36" Height="36" Click="AlignJustifyBtn_Click"
                              ToolTipService.ToolTip="Justify">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                </ToggleButton>
                <AppBarSeparator/>
                <ToggleButton x:Name="BulletsBtn" Width="36" Height="36" Click="BulletsBtn_Click"
                              ToolTipService.ToolTip="Bullets">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
                </ToggleButton>
                <Button x:Name="ColorBtn" Width="36" Height="36" Click="ColorBtn_Click"
                        ToolTipService.ToolTip="Text Color">
                    <FontIcon Glyph="&#xE790;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Rich text editor -->
        <Border Grid.Row="2" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" 
                BorderThickness="1" CornerRadius="4">
            <RichEditBox x:Name="Editor"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         SelectionChanged="Editor_SelectionChanged"
                         PlaceholderText="Start typing..."/>
        </Border>

        <!-- Status bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.7"/>
        </StackPanel>
    </Grid>
</ContentDialog>
